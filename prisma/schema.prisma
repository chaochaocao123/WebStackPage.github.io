// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 分类
model Category {
  id        Int      @id @default(autoincrement())
  key       String   @unique // 例如 "ERP管理系统"
  label     String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools Tool[]
}

// 工具
model Tool {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  url         String   // 工具官网
  business    String   // 业务描述
  categoryKey String   // FK → Category.key
  affiliateUrl String // 联盟推广链接
  discount    String   @default("")
  logo        String?  // 工具 logo URL
  featured    Boolean  @default(false) // 是否首页推荐
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryKey], references: [key])
}

// 文章
model Article {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  content     String   // Text
  excerpt     String
  cover       String?
  category    String?
  tags        String   @default("[]") // JSON string
  source      String?
  sourceType  String   @default("manual")
  author      String   @default("跨境工具说")
  publishedAt DateTime @default(now())
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // v11.21 SEO 分批管理：默认全走"kjgjs 首发"策略
  // isReposted=true 时 → 详情页 canonical 指 sourceUrl + noindex,follow + sitemap 跳过
  // 当前 0 存量，全部默认 false；保留字段防御未来发外站时使用
  isReposted    Boolean   @default(false)
  sourceUrl     String?   // 外站原文链接（isReposted=true 时必填）
  baiduPushedAt DateTime? // 上次主动推百度时间（首发策略证据）

  // v11.32 草稿状态：'draft' / 'published'（默认 'published'，保持现状不变）
  // 详情页 / sitemap 只展示 status='published' 的；草稿可随时再编辑
  status        String    @default("published")

  @@index([status])
}

// 优惠
model Deal {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  brand       String
  brandLogo   String?
  category    String?
  discount    String?
  description String   // Text
  startDate   DateTime?
  endDate     DateTime?
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 资讯（自动抓取 + 手动发布）
model News {
  id          Int      @id @default(autoincrement())
  title       String
  url         String   @unique
  source      String   // amz123 / mjzj / wearesellers / cifnews / manual
  sourceLogo  String?
  summary     String?
  cover       String?
  category    String?
  content     String?  // 完整正文 HTML（仅自动抓取时填充，详情页内嵌渲染）
  publishedAt DateTime
  crawledAt   DateTime @default(now())
  sourceType  String   @default("crawl")  // crawl / manual
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
  @@index([publishedAt])
}

// 广告位
model AdSpot {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  name     String
  imageUrl String
  linkUrl  String
  active   Boolean @default(true)
  sort     Int     @default(0)
}

// 优化6：页面访问埋点记录
model PageView {
  id         Int       @id @default(autoincrement())
  sessionId  String    // 会话 ID（用于计算 UV）
  path       String    // 页面路径
  referrer   String?   // 来源页面
  userAgent  String?   // 浏览器 UA
  enteredAt  DateTime  @default(now())  // 进入时间
  leftAt     DateTime? // 离开时间
  duration   Int?      // 停留时长（秒）
  
  @@index([sessionId])
  @@index([path])
  @@index([enteredAt])
}
// 站内搜索日志（关键词监控）
model SearchLog {
  id          Int      @id @default(autoincrement())
  keyword     String   // 搜索词（去前 100 字符）
  resultCount Int      // 结果数（0 = 无结果）
  tab         String   @default("all")  // all/tools/news/articles/deals
  sessionId   String?  // 关联 PageView 会话（无则匿名）
  noResult    Boolean  @default(false) // 是否无结果（重点关注）
  createdAt   DateTime @default(now())

  @@index([keyword])
  @@index([createdAt])
  @@index([noResult])
}

// v11.28 百度主动推送日志：记录每次推百度动作，用于 quota 提示
// 百度普通收录 API 配额 = 10 次/天（v11.25 实测确认，全局配额，明天 0 点重置）
model BaiduPushLog {
  id         Int      @id @default(autoincrement())
  articleId  Int      // 关联 Article.id
  articleSlug String  // 冗余存 slug（文章可能删，但日志保留）
  url        String   // 推百度的完整 URL
  success    Boolean  // 百度是否接受
  baiduRemain Int?    // 百度返回的 remain（实时剩余；如失败则为 null）
  baiduSuccess Int?   // 百度返回的 success（本次成功条数；通常 1）
  detail     String?  // 失败原因 or 百度原始响应
  pushedAt   DateTime @default(now())

  @@index([pushedAt])
  @@index([articleId])
}

// v11.31 友情链接：曹总手动维护，互换链接用
// 前台 /links 展示页 + 后台 /admin/friends CRUD
// 分组展示（按 category 字段聚合），排序按 sort 升序
model FriendLink {
  id          Int      @id @default(autoincrement())
  name        String   // 友链名（如 "AMZ123"）
  url         String   // 友链 URL（必填）
  description String?  // 友链描述（卡片悬停 tooltip 用，可选）
  category    String   @default("默认")  // 分组（默认/热门链接/跨境综合/跨境物流/...）
  logo        String?  // 友链 logo URL（可选，留空则只显示文字）
  sort        Int      @default(0)  // 排序（升序，数字越小越靠前）
  isActive    Boolean  @default(true)  // 是否启用（false 则前台不展示）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sort])
  @@index([isActive])
}